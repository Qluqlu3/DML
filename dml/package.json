{
  "name": "dml",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "next dev -p 5050",
    "build": "next build",
    "start": "next start -p 5050",
    "lint": "biome lint --error-on-warnings .",
    "lint:css": "stylelint 'src/**/*.css'",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write .",
    "db:migrate": "prisma migrate dev",
    "db:seed": "NODE_ENV=development prisma db seed",
    "db:studio": "prisma studio",
    "admin:create-user": "tsx prisma/create-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.38.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "lefthook": "^2.2.2",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
