{
  "name": "aws-arch-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
